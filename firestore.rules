rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and search history
    match /users/{userId} {
      // Users can only read and write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Basic schema validation for search history
      allow update: if request.auth.uid == userId 
                    && request.resource.data.keys().hasAll(['lastPincode', 'lastSearch'])
                    && request.resource.data.lastPincode is string
                    && request.resource.data.lastPincode.size() == 6;
    }

    // Chat History
    match /chatHistory/{chatId} {
      // Users can only read their own chats
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Users can create chats if their auth uid matches the doc's userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Prevent users from updating other people's chats
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Prevent deleting chat history (optional compliance feature)
      allow delete: if false;
    }
  }
}
